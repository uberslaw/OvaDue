#!/usr/bin/env python
"""Test script to verify delay calculation works with actual data."""

from pathlib import Path
import pandas as pd

def test_delay_calculation():
    """Load data and test delay calculation."""

    # Find latest XLS file
    xls_files = sorted(Path('.').glob('*.xls'), reverse=True)
    if not xls_files:
        xls_files = sorted(Path('uploads').glob('*.xls'), reverse=True)

    if not xls_files:
        print("❌ No XLS files found")
        return

    print(f"📂 Loading: {xls_files[0].name}")
    df = pd.read_excel(xls_files[0])

    # Verify columns exist
    required_cols = ['HPReceiveDate', 'PlannedDeliveryDate', 'Standard LT']
    for col in required_cols:
        if col not in df.columns:
            print(f"❌ Missing column: {col}")
            return

    print(f"✓ All required columns found\n")

    # Show data types
    print("Data types:")
    print(f"  HPReceiveDate: {df['HPReceiveDate'].dtype}")
    print(f"  PlannedDeliveryDate: {df['PlannedDeliveryDate'].dtype}")
    print(f"  Standard LT: {df['Standard LT'].dtype}\n")

    # Convert to numeric
    df['Standard LT'] = pd.to_numeric(df['Standard LT'], errors='coerce')

    # Convert dates
    df['HPReceiveDate'] = pd.to_datetime(df['HPReceiveDate'], errors='coerce')
    df['PlannedDeliveryDate'] = pd.to_datetime(df['PlannedDeliveryDate'], errors='coerce')

    print("After conversion:")
    print(f"  HPReceiveDate nulls: {df['HPReceiveDate'].isna().sum()}")
    print(f"  PlannedDeliveryDate nulls: {df['PlannedDeliveryDate'].isna().sum()}")
    print(f"  Standard LT nulls: {df['Standard LT'].isna().sum()}\n")

    # Calculate baseline and delay
    df["BaselineExpectedDeliveryDate"] = df.apply(
        lambda row: (pd.to_datetime(row["HPReceiveDate"]) + pd.to_timedelta(row["Standard LT"], unit="D"))
        if pd.notna(row["HPReceiveDate"]) and pd.notna(row["Standard LT"]) else pd.NaT,
        axis=1
    )

    df["DelayDays"] = (df["PlannedDeliveryDate"] - df["BaselineExpectedDeliveryDate"]).dt.days
    df["DelayDays"] = df["DelayDays"].fillna(0).astype(int)
    df["IsDelayed"] = df["DelayDays"] > 0
    df["DelayWeeks"] = (df["DelayDays"] / 7.0).round(1)

    # Show results
    print("Delay Calculation Results:")
    print(f"  Total rows: {len(df)}")
    print(f"  Delayed rows: {df['IsDelayed'].sum()}")
    print(f"  Non-delayed rows: {(~df['IsDelayed']).sum()}\n")

    # Show some delayed orders
    delayed = df[df['IsDelayed']].head(10)
    if len(delayed) > 0:
        print("First 10 delayed orders:")
        print(delayed[['HPReceiveDate', 'PlannedDeliveryDate', 'Standard LT', 'BaselineExpectedDeliveryDate', 'DelayDays', 'DelayWeeks']].to_string())
    else:
        print("⚠️  No delayed orders found")
        print("\nShowing first 5 orders for debugging:")
        print(df[['HPReceiveDate', 'PlannedDeliveryDate', 'Standard LT', 'BaselineExpectedDeliveryDate', 'DelayDays']].head().to_string())

if __name__ == "__main__":
    test_delay_calculation()
